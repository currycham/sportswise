# 本机预览默认允许演示和本机验证码；上线必须设 APP_ENV=production
APP_ENV=development
DB_PATH=data/sportswise.db
SITE_URL=http://127.0.0.1:8500
INVITE_CODE=
ADMIN_EMAILS=you@example.com
# 可选：不配置时使用规则生成和有限的中文指令解析，页面如实标明
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
MODEL_PRICE_INPUT=2
MODEL_PRICE_OUTPUT=8
DAILY_BUDGET_YUAN=20
USER_DAILY_CALLS=30
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 独立计划生成/评审；输入输出单价用于保守的预算估算，可按供应商账单校准
PLANNER_MODEL=deepseek-flash
PLANNER_REVIEW_MODEL=deepseek-flash
PLANNER_EXPERT_MODEL=deepseek-v4-pro
PLANNER_EFFORT=low
PLANNER_AUTHOR_EFFORT=low
PLANNER_MAX_TOKENS=32768
PLANNER_REVIEW_MAX_TOKENS=32768
PLANNER_PRICE_INPUT=3
PLANNER_PRICE_OUTPUT=12
PLANNER_EXPERT_PRICE_INPUT=12
PLANNER_EXPERT_PRICE_OUTPUT=48
